# Optional System-2 draft/serve (OpenAI-compatible). Leave unset for the $0 mock path.
# Used only with: spectrace run|bakeoff --provider openai-compat
# Never required for pytest or `spectrace grade`.
# SPECTRACE_BASE_URL=http://127.0.0.1:11434/v1
# SPECTRACE_API_KEY=
# SPECTRACE_MODEL=local-model

# Optional TypeSafe AI Jev (System-1 step grader, not a draft model).
# Never required for tests or `spectrace grade --provider mock`.
# TYPESAFE_API_KEY=
# TYPESAFE_KEY=          # alias accepted by spectrace
# SPECTRACE_JEV_URL=https://api.typesafe.ai/v1/systemone
# SPECTRACE_JEV_MODEL=jev-latest
